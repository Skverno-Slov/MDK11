<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LabWork21.Pages.MoviePage"
             Title="MoviePage">
    <VerticalStackLayout>
        <Label 
            Text="Фильмы"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Picker x:Name="SortPicker" Title = "Сортировка"
                SelectedIndexChanged="SortPicker_SelectedIndexChanged">
            <Picker.Items>
                <x:String>По названию</x:String>
                <x:String>Меньше длительность</x:String>
                <x:String>Сначала старые</x:String>
                <x:String>Сначала новые</x:String>
            </Picker.Items>
        </Picker>
        <Entry x:Name="MovieNameEntry" Placeholder="Поиск по названию ..." Completed="MovieNameEntry_Completed"/>
        <ListView ItemsSource="{Binding Movies}" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Always">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10">
                            <Label Text="---Id---"/>
                            <Label Text="{Binding MovieId}"/>
                            <Label Text="---Название---"/>
                            <Label Text="{Binding Name}"/>
                            <Label Text="---Длительность---"/>
                            <Label Text="{Binding Duration}"/>
                            <Label Text="---Год выпуска---"/>
                            <Label Text="{Binding Year}"/>
                            <Label Text="---Описание---"/>
                            <Label Text="{Binding Description}"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>