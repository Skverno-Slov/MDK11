<Window x:Class="LabWork20Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork20Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closed="Window_Closed">
    <StackPanel>
        <TextBlock>Выбор фильма</TextBlock>
        <ComboBox x:Name="MoviesComboBox" DisplayMemberPath="Name"/>
        <TextBlock>Выбор Кадра</TextBlock>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="FileNameTextBlock" Width="700"/>
            <Button x:Name="SetMovieFrameButton" Content="Выбрать кадр" Click="SetMovieFrameButton_Click"/>
        </StackPanel>
        <Button x:Name="SaveMovieButton" Content="Сохранить" Click="SaveMovieButton_Click"/>
    </StackPanel>
</Window>
