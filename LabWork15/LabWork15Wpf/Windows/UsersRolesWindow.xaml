<Window x:Class="LabWork15Wpf.Windows.UsersRolesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork15Wpf.Windows"
        mc:Ignorable="d"
        Title="UsersRolesWindow" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Width="250">
            <TextBlock Text="Логин"/>
            <TextBlock x:Name="LoginTextBlock"/>
            <TextBlock Text="Роль"/>
            <ComboBox x:Name="RolesComboBox" DisplayMemberPath="Name"/>
            <Button x:Name="SaveButton" Content="Сохранить изменения" Click="SaveButton_Click"/>
        </StackPanel>
        <DataGrid x:Name="UsersDataGrid"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectedCellsChanged="UsersDataGrid_SelectedCellsChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" 
                            Binding ="{Binding Login}" 
                            Width="200"/>
                <DataGridTextColumn Header="Роль" 
                            Binding="{Binding Role.Name}" 
                            Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
