<Window x:Class="LabWork15Wpf.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork15Wpf"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800" Closed="Window_Closed">
    <StackPanel>
        <TextBlock Text="Логи"/>
        <TextBox x:Name="LoginTextBox"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox"/>
        <Button x:Name="RegistrationButton" Content="Зарегистрироватся" Click="RegistrationButton_Click"/>
        <Button x:Name="ToAuthorizationButton" Content="Уже есть аккаунт? Войти" Click="ToAuthorizationButton_Click"/>
    </StackPanel>
</Window>
