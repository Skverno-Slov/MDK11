<Window x:Class="LabWork15Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork15Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closed="Window_Closed">
    <StackPanel>
        <TextBlock x:Name="LoginTextBlock" Text="Войдите для продолжения"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ToPersonalСabinetButton" Content="Личный кабинет"/>
            <Button x:Name="ToMoviesButton" Content="Фильмы"/>
            <Button x:Name="ToTicketsButton" Content="Проверка билетов"/>
            <Button x:Name="AddUserButton" Content="Добавить пользователя"/>
            <Button x:Name="ToUsersButton" Content="Роли пользователей" Click="ToUsersButton_Click"/>
        </StackPanel>
        <Button x:Name="ExitButton" Content="Выйти" Click="ExitButton_Click"/>
    </StackPanel>
</Window>
