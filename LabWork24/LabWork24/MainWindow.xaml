<Window x:Class="LabWork24.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork24"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Width="250">
            <DataGrid x:Name="TicketDataGrid" SelectedCellsChanged="TicketsDataGrid_SelectedCellsChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom">
            <Button x:Name="SaveTxtButton" Content="Сохранить txt" Click="SaveTxtButton_Click"/>
            <Button x:Name="SavePdfButton" Content="Сохранит pdf" Click="SavePdfButton_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="TicketIdTextBlock" Text="Выбирете билет"/>
            <TextBlock x:Name="NameTextBlock"/>
            <TextBlock x:Name="StartDateTextBlock"/>
            <TextBlock x:Name="CinemaTextBlock"/>
            <TextBlock x:Name="HallNumberTextBlock"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="RowTextBlock"/>
                <TextBlock x:Name="SeatTextBlock"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
